# Local dev scratch
.local/

# Dependencies. Note what is deliberately NOT here: the build output.
# Claude Code installs a plugin by fetching the marketplace source.path from GitHub —
# no install step, no npm install, no build. Whatever is committed is what runs, so
# hooks/dist, mcp/dist and bin/statusline.mjs are committed artifacts.
# No trailing slash: a worktree often symlinks this path, and `node_modules/` matches directories only.
node_modules

# A parent .gitignore may exclude build output. This plugin's is committed on purpose, so
# re-include it here — a deeper .gitignore wins, and without these two lines the plugin
# installs with no hooks at all.
!hooks/dist/
!mcp/dist/

# Same story, different rule. A parent .gitignore may ignore `.mcp.json` so nobody
# accidentally commits their own local MCP server config — but this one is the plugin's own
# manifest: it registers the `mubit` server, and therefore every
# `mcp__plugin_mubit-memory_mubit__*` tool the skills call. Untracked, it would never be
# published, and the plugin would install with no MCP server at all — skills load, declare
# their tools, and every one resolves to nothing.
!.mcp.json

# Editor / OS noise
.DS_Store
*.log
